<?xml version="1.0" encoding="utf-8"?><!--
    「图片域名」的选择页：三个单选项 + 「自定义」专属的输入框。
    输入框缩进对齐在第三项之下，表明它是该选项的参数而非独立设置。
    单选项文案由代码从 R.array.image_domain 填入，此处不写死，避免选项列表出现第二份。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioGroup
            android:id="@+id/rg_image_domain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_image_domain_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <RadioButton
                android:id="@+id/rb_image_domain_alt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <RadioButton
                android:id="@+id/rb_image_domain_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

        </RadioGroup>

        <EditText
            android:id="@+id/et_image_domain_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/setting_image_domain_custom_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:minHeight="48dp" />

    </LinearLayout>

</ScrollView>
